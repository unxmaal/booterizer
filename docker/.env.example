# Booterizer Environment Configuration
# Copy this file to .env and edit for your setup:
#   cp .env.example .env

# REQUIRED: Your SGI's MAC address
# Find it on SGI PROM with: printenv eaddr
SGI_MAC=08:00:69:xx:xx:xx

# SGI hostname (used in /etc/hosts and RSH trust)
SGI_HOSTNAME=sgi

# IP address to assign to SGI via DHCP
SGI_IP=172.16.42.2

# Your laptop's IP on the direct-cable interface
HOST_IP=172.16.42.1

# Network interface connected to SGI
# Find yours with: ip link show
HOST_INTERFACE=eth0

# Network configuration
# Using 172.16.42.0/24 to avoid conflicts with common home networks
NETWORK=172.16.42.0
NETMASK=255.255.255.0
DOMAIN=local

# IRIX version being installed
# This determines the boot image path: ${IRIX_VERSION}/Overlay/disc1/stand/fx.64
IRIX_VERSION=6.5.30
